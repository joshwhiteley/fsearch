#!/usr/bin/expect -f

set timeout 20
if {$argc != 1} {
    puts stderr "usage: smoke.exp /path/to/fsearch"
    exit 2
}

set bin [file normalize [lindex $argv 0]]
set tmp [exec mktemp -d /tmp/fsearch-smoke.XXXXXX]
set home "$tmp/home"
set config "$tmp/config/fsearch"
set cache "$tmp/cache"
file mkdir $home $config $cache

set note [open "$home/meeting-notes.md" w]
puts $note "project launch checklist"
close $note

set cfg [open "$config/config.toml" w]
puts $cfg "roots = \[\"$home\"\]"
puts $cfg "excludes = \[\]"
puts $cfg "index_apps = false"
puts $cfg "mouse = false"
puts $cfg "quiet = \[\]"
puts $cfg "\[searches\]"
puts $cfg "notes = \"ext:md meeting\""
close $cfg

log_user 0
spawn -noecho sh -c "stty rows 30 cols 120; exec env HOME=$home XDG_CONFIG_HOME=$tmp/config XDG_CACHE_HOME=$cache XDG_STATE_HOME=$tmp/state TERM=xterm-256color $bin"
expect {
    -exact "\033\[?2004h" {}
    timeout { puts stderr "bracketed paste was not enabled"; exit 1 }
}
expect {
    -re {fsearch} {}
    timeout {
        puts stderr "TUI did not start"
        exit 1
    }
}

# First prove the Paste event changes the query, rather than merely observing
# the initial unfiltered result (which would also pass with a no-op handler).
expect {
    -re {meeting-notes\.md} {}
    timeout { puts stderr "initial index did not appear"; exit 1 }
}
send -- "\033\[200~zzfsearchabsent987654321\033\[201~"
expect {
    -re {No matches} {}
    timeout { puts stderr "pasted query was not applied"; exit 1 }
}
send -- "\025\033\[200~meeting\033\[201~"
expect {
    -re {meeting-notes\.md} {}
    timeout {
        puts stderr "pasted query did not produce the indexed file"
        send -- "\003"
        exit 1
    }
}

send -- "\033"
expect {
    -exact "\033\[?2004l" {}
    timeout { puts stderr "bracketed paste was not restored on exit"; exit 1 }
}
expect {
    eof {}
    timeout {
        puts stderr "TUI did not exit after Escape"
        send -- "\003"
        exit 1
    }
}

set status [wait]
if {[lindex $status 3] != 0} {
    file delete -force $tmp
    exit [lindex $status 3]
}

# No-history still provides the UI but creates no history/session files.
spawn -noecho sh -c "stty rows 30 cols 120; exec env HOME=$home XDG_CONFIG_HOME=$tmp/config XDG_CACHE_HOME=$cache XDG_STATE_HOME=$tmp/private-state TERM=xterm-256color $bin --no-history --pick missing"
expect {
    -re {No matches} {}
    timeout { puts stderr "private pick UI did not settle"; exit 1 }
}
# A multiline clipboard paste is one edit, not Enter/open or a stream of
# shortcuts. Opening the saved picker afterwards proves it did not accept/exit.
send -- "\025\033\[200~meeting\r\nnotes\033\[201~"
expect {
    -re {meeting-notes\.md} {}
    eof { puts stderr "pasted newline accepted the result"; exit 1 }
    timeout { puts stderr "multiline paste did not search"; exit 1 }
}
# Start the picker from an empty result set so applying its query must paint
# a new result, rather than depending on unchanged terminal cells being emitted.
send -- "\025zzfsearchabsent987654321"
expect {
    -re {No matches} {}
    timeout { puts stderr "private query did not clear results"; exit 1 }
}
send -- "\014"
# Ratatui can skip blank cells with cursor moves between title words.
expect {
    -re {saved.*searches.*\(1/1\)} {}
    timeout { puts stderr "saved-search picker did not open"; exit 1 }
}
send -- "\033\[200~zzfsearchabsent987654321\033\[201~"
expect {
    -re {No.*matching.*saved.*searches} {}
    timeout { puts stderr "paste did not filter saved searches"; exit 1 }
}
send -- "\027\033\[200~notes\033\[201~"
send -- "\r"
expect {
    -re {meeting-notes\.md} {}
    timeout { puts stderr "private pick UI did not show results"; exit 1 }
}
send -- "\r"
expect {
    eof {}
    timeout { puts stderr "private pick UI did not exit"; send -- "\003"; exit 1 }
}
set status [wait]
if {[file exists "$tmp/private-state"]} {
    puts stderr "--no-history wrote state"
    file delete -force $tmp
    exit 1
}
file delete -force $tmp
exit [lindex $status 3]
